# Copy this file to .env (optional - the app also reads plain env vars)
# and fill in values only if you want the OPTIONAL features below.

# Port the Flask server listens on (default 5000)
PORT=5000

# Set to 1 to enable verbose Flask debug/auto-reload during development
FLASK_DEBUG=0

# ---- OPTIONAL: LLM-enriched recruiter summary (see llm_enrich.py) ----
# Leave both unset to run the platform fully offline with the
# deterministic rubric engine (this is the default and requires no keys).
# ENABLE_LLM_FEEDBACK=1
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
